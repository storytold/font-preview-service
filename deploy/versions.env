# Images the deploy pins besides the service itself. Update by digest, never by tag alone.
CADDY_IMAGE=docker.io/library/caddy:2.11.7@sha256:504a44d7d74bd2bc28a66afc4774912fc21223ca8a67734af1c54ab2f999b489
