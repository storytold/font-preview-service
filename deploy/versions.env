# Font index pinned on a new host (setup and ignition write it into sync.env when the host has no
# pin yet). INDEX_SHA256 is the sha256 of that commit's sources.json in aiongg/craft-font-index.
# To bump: edit both lines here, then run deploy.sh index <ssh-dest> <commit> <sha256> on live hosts.
INDEX_COMMIT=995ef2000a0159d70da245e22cfa0797a0756ae8
