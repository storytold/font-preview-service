# Read by fps-sync.service. INDEX_COMMIT and INDEX_SHA256 are public values: a commit of the
# index repository and the sha256 of that commit's sources.json. setup and ignition add the pin
# from versions.env when none is set; deploy.sh index replaces it. setup never overwrites this file.
INDEX_REPO=aiongg/craft-font-index
SYNC_THREADS=1
# SYNC_MEMORY_MB=
# SYNC_MAX_FAILED_PERCENT=
# SYNC_FORCE=
# Memory limit of the sync container (default 640m; a full sync at 1 thread peaks near 280 MB).
# SYNC_CONTAINER_MEMORY=640m
